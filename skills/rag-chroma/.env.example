# Copy to .env beside docker-compose.yml. This file contains no credentials.
# Compose 2.24+; Linux host networking connects RAG to host-local services.
# Runtime overrides in .env are passed to rag-mcp; shell runtime overrides
# must be written here too (Compose only passes explicitly mapped shell vars).
# LLM_API_KEY=     # set privately; needed only for rag_answer
# LLM_BASE_URL=https://your-compatible-api.example/v1
# LLM_MODEL=your-model
# VAULT_MCP_URL=http://127.0.0.1:27125/mcp
# WATCH_INTERVAL=60
# RAG_PORT=8081
# RAG_MCP_URL=http://127.0.0.1:8081
# CHROMA_PORT=8000 # must match CHROMA_PUBLISH_PORT

# Deployment and build choices (defaults are in Compose/Dockerfile).
# CHROMA_IMAGE=chromadb/chroma:0.6.3
# CHROMA_PUBLISH_PORT=8000
# CHROMA_DATA_DIR=./data/chroma
# RAG_LOG_HOST_DIR=./logs
# RAG_CONFIG_PATH=./config.toml # file mounted into the container
# PYTHON_IMAGE=python:3.12-slim
# E5_REPO=Xenova/multilingual-e5-small
# E5_REVISION=main # use a commit ID for reproducible model downloads
# E5_MODEL_FILE=model_quantized.onnx # align EMBED_MODEL_FILE in TOML
# TZ=Asia/Shanghai
# MALLOC_ARENA_MAX=2
# MALLOC_TRIM_THRESHOLD_=0
