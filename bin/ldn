#!/usr/bin/env bash
set -euo pipefail

SKILLS_DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
REGISTRY="$SKILLS_DIR/registry.yaml"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

skill_names() {
  awk '/^  - name:/ {print $3}' "$REGISTRY"
}

skill_path() {
  local name="$1"
  awk -v n="$name" '
    $0 ~ "^  - name: "n"$" {found=1; next}
    found && /path:/ {sub(".*path: *",""); print; exit}
  ' "$REGISTRY"
}

skill_dir() {
  echo "$SKILLS_DIR/$(skill_path "$1")"
}

skill_scope() {
  local dir="$1"
  awk '/^scope:/ {print $2}' "$dir/metadata.yaml"
}

skill_desc() {
  local dir="$1"
  awk '/^description:/ {sub("^description: *",""); print; exit}' "$dir/metadata.yaml"
}

# Resolve the selected scope independently of the caller's working directory.
skills_root() {
  local agent="$1"
  if [[ "$SCOPE" == "global" ]]; then
    case "$agent" in
      claude) printf '%s' "$HOME/.claude/skills" ;;
      codex) printf '%s' "$HOME/.agents/skills" ;;
      opencode) printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" ;;
    esac
  else
    local directory="$agent"
    [[ "$agent" == "codex" ]] && directory="agents"
    printf '%s' "$PWD/.$directory/skills"
  fi
}

is_installed() {
  local name="$1" agent
  local agents=("$AGENT")
  case "$AGENT" in
    both) agents=(claude codex) ;;
    all) agents=(claude codex opencode) ;;
  esac
  for agent in "${agents[@]}"; do
    [[ -f "$(skills_root "$agent")/$name/SKILL.md" ]] || return 1
  done
}

# ---------------------------------------------------------------------------
# List (plaintext)
# ---------------------------------------------------------------------------

cmd_list() {
  printf "${CYAN}lidaning-skills${NC} ${DIM}[$AGENT, $SCOPE]${NC}\n\n"
  while IFS= read -r name; do
    local dir scope desc marker
    dir=$(skill_dir "$name")
    scope="$SCOPE"
    desc=$(skill_desc "$dir")
    if is_installed "$name"; then
      marker="${GREEN}[installed]${NC}"
    else
      marker="${DIM}[not installed]${NC}"
    fi
    printf "  %-22s %-8s %b  %b\n" "$name" "[$scope]" "$marker" "$desc"
  done < <(skill_names)
  echo ""
}

# ---------------------------------------------------------------------------
# MCP inject: write skill mcp.json configs into the selected scope
# ---------------------------------------------------------------------------

# Returns a space-separated list of "name:mcp_json_path" for skills that ship mcp.json
skills_with_mcp() {
  while IFS= read -r name; do
    local dir mcp
    dir=$(skill_dir "$name")
    mcp="$dir/mcp.json"
    [[ -f "$mcp" ]] && printf '%s\n' "$name"
  done < <(skill_names)
}

cmd_mcp_inject() {
  local names=()
  mapfile -t names < <(skills_with_mcp)
  if [[ ${#names[@]} -eq 0 ]]; then
    printf "[mcp] no skills ship mcp.json — nothing to inject.\n"
    return 0
  fi
  "$SKILLS_DIR/install.sh" "${names[@]}" "--$SCOPE" --mcp-only --agent "$AGENT"
}

# ---------------------------------------------------------------------------
# Interactive setup
# ---------------------------------------------------------------------------

choose_many() {
  local header="$1"
  shift
  gum choose --no-limit --header="$header  (x/tab=toggle  enter=confirm  esc=cancel)" \
    --cursor-prefix="[ ] " --selected-prefix="[x] " --unselected-prefix="[ ] " "$@"
}

cancelled() {
  printf 'Cancelled. No changes made.\n'
}

cmd_manage() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'No interactive terminal — showing skills instead.\n'
    printf 'Use ldn add <name> or ldn remove <name> to manage skills.\n\n'
    cmd_list
    return 0
  fi

  if ! command -v gum &>/dev/null; then
    printf "${YELLOW}gum not found — falling back to plain list.${NC}\n"
    printf "Install gum: https://github.com/charmbracelet/gum\n\n"
    cmd_list
    return 0
  fi

  if ! $SCOPE_SET; then
    SCOPE=$(gum choose --header="Installation scope ($PWD)" project global) || { cancelled; return; }
  fi
  if ! $AGENT_SET; then
    AGENT=$(gum choose --header="Agent (both = Claude Code + Codex; all includes OpenCode)" \
      claude codex opencode both all) || { cancelled; return; }
  fi

  local all_skills=() selected_flags=() mcp_skills=()
  mapfile -t all_skills < <(skill_names)
  mapfile -t mcp_skills < <(skills_with_mcp)

  if [[ ${#all_skills[@]} -eq 0 ]]; then
    printf 'No skills found in registry.\n' >&2
    return 1
  fi

  local name
  local -A installed=() selected=()
  for name in "${all_skills[@]}"; do
    if is_installed "$name"; then
      installed["$name"]=1
      selected_flags+=(--selected="$name")
    fi
  done

  local chosen
  chosen=$(choose_many "[$AGENT, $SCOPE] Skills to keep or install" \
    "${selected_flags[@]}" -- "${all_skills[@]}") || { cancelled; return; }
  while IFS= read -r name; do
    [[ -n "$name" ]] && selected["$name"]=1
  done <<<"$chosen"

  local mcp_action=keep mcp_selected=()
  if [[ ${#mcp_skills[@]} -gt 0 ]]; then
    mcp_action=$(gum choose --header="[$AGENT, $SCOPE] MCP servers" keep register deregister) || {
      cancelled
      return
    }
    if [[ "$mcp_action" != keep ]]; then
      chosen=$(choose_many "Choose skills whose MCP servers to $mcp_action" -- "${mcp_skills[@]}") || {
        cancelled
        return
      }
      if [[ -n "$chosen" ]]; then
        mapfile -t mcp_selected <<<"$chosen"
      fi
    fi
  fi

  local add=() remove=() target=("--$SCOPE" --agent "$AGENT")
  for name in "${all_skills[@]}"; do
    if [[ -n "${selected[$name]:-}" && -z "${installed[$name]:-}" ]]; then
      add+=("$name")
    elif [[ -z "${selected[$name]:-}" && -n "${installed[$name]:-}" ]]; then
      remove+=("$name")
    fi
  done

  if [[ ${#add[@]} -gt 0 ]]; then
    "$SKILLS_DIR/install.sh" "${add[@]}" "${target[@]}" --no-mcp
  fi
  if [[ ${#remove[@]} -gt 0 ]]; then
    "$SKILLS_DIR/install.sh" "${remove[@]}" "${target[@]}" --no-mcp --remove
  fi
  if [[ ${#mcp_selected[@]} -gt 0 ]]; then
    local mcp_flags=(--mcp-only)
    [[ "$mcp_action" == deregister ]] && mcp_flags+=(--remove)
    "$SKILLS_DIR/install.sh" "${mcp_selected[@]}" "${target[@]}" "${mcp_flags[@]}"
  fi

  if [[ ${#add[@]} -eq 0 && ${#remove[@]} -eq 0 && ${#mcp_selected[@]} -eq 0 ]]; then
    printf 'No changes.\n'
  fi
  printf '\n'
  cmd_list
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

usage() {
  printf "${CYAN}ldn${NC} — lidaning-skills manager\n\n"
  printf "  ${CYAN}ldn${NC}          Choose scope, agent, skills, and MCP servers (requires gum)\n"
  printf "  ${CYAN}ldn list${NC}     Plain-text list with install status\n"
  printf '  ldn add <name...>     Install skills without the checkbox UI\n'
  printf '  ldn remove <name...>  Remove skills without the checkbox UI\n'
  printf "  ${CYAN}ldn mcp inject${NC} Write skill MCP servers into the selected scope\n\n"
  printf "  --global / -g   Manage skills for all projects (current user)\n"
  printf "  --project / -p  Manage skills in cwd (default for explicit commands)\n\n"
  printf "  ${CYAN}-agent <claude|codex|both|opencode|all>${NC}  Agent to manage skills for (default: claude)\n"
  printf "      claude    .claude/skills/, .mcp.json\n"
  printf "      codex     .agents/skills/, .codex/config.toml\n"
  printf "      both      Claude Code + Codex; all also includes OpenCode\n"
  printf "      opencode  .opencode/skills/, opencode.json\n"
  printf "  e.g. ${CYAN}ldn -agent opencode${NC}, ${CYAN}ldn --global --agent codex${NC}\n"
}

# Agent and scope options may appear anywhere; everything else is the command.
AGENT="claude"
SCOPE="project"
AGENT_SET=false
SCOPE_SET=false
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --global | -g) SCOPE="global"; SCOPE_SET=true; shift ;;
  --project | -p) SCOPE="project"; SCOPE_SET=true; shift ;;
  -agent | --agent | -a)
    [[ $# -ge 2 ]] || { printf "ldn: %s needs claude, codex, both, opencode or all\n" "$1" >&2; exit 1; }
    AGENT="$2"; AGENT_SET=true; shift 2 ;;
  -agent=* | --agent=*) AGENT="${1#*=}"; AGENT_SET=true; shift ;;
  *) ARGS+=("$1"); shift ;;
  esac
done
case "$AGENT" in
claude | codex | both | opencode | all) ;;
*) printf "ldn: unknown agent '%s' (expected claude, codex, both, opencode or all)\n" "$AGENT" >&2; exit 1 ;;
esac
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-}" in
list | ls) cmd_list ;;
add | remove | rm)
  command="$1"
  shift
  [[ $# -gt 0 ]] || { printf 'ldn: %s requires at least one skill name\n' "$command" >&2; exit 1; }
  installer_args=("$@" "--$SCOPE" --agent "$AGENT")
  [[ "$command" == "add" ]] || installer_args+=(--remove)
  "$SKILLS_DIR/install.sh" "${installer_args[@]}"
  ;;
mcp)
  case "${2:-}" in
  inject) cmd_mcp_inject ;;
  *) printf "Usage: ldn mcp inject\n" ;;
  esac
  ;;
-h | --help) usage ;;
"") cmd_manage ;;
*) usage ;;
esac
