#!/usr/bin/env bash
set -euo pipefail

SKILLS_DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
REGISTRY="$SKILLS_DIR/registry.yaml"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

skill_names() {
  awk '/^  - name:/ {print $3}' "$REGISTRY"
}

skill_path() {
  local name="$1"
  awk -v n="$name" '
    $0 ~ "^  - name: "n"$" {found=1; next}
    found && /path:/ {sub(".*path: *",""); print; exit}
  ' "$REGISTRY"
}

skill_dir() {
  echo "$SKILLS_DIR/$(skill_path "$1")"
}

skill_scope() {
  local dir="$1"
  awk '/^scope:/ {print $2}' "$dir/metadata.yaml"
}

skill_desc() {
  local dir="$1"
  awk '/^description:/ {sub("^description: *",""); print; exit}' "$dir/metadata.yaml"
}

# Resolve the selected scope independently of the caller's working directory.
skills_root() {
  local agent="$1"
  if [[ "$SCOPE" == "global" ]]; then
    case "$agent" in
      claude) printf '%s' "$HOME/.claude/skills" ;;
      codex) printf '%s' "$HOME/.agents/skills" ;;
      opencode) printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" ;;
    esac
  else
    local directory="$agent"
    [[ "$agent" == "codex" ]] && directory="agents"
    printf '%s' "$PWD/.$directory/skills"
  fi
}

is_installed() {
  local name="$1" agent
  local agents=("$AGENT")
  case "$AGENT" in
    both) agents=(claude codex) ;;
    all) agents=(claude codex opencode) ;;
  esac
  for agent in "${agents[@]}"; do
    [[ -f "$(skills_root "$agent")/$name/SKILL.md" ]] || return 1
  done
}

mcp_config() {
  local agent="$1" config
  if [[ "$SCOPE" == "global" ]]; then
    case "$agent" in
      claude) config="$HOME/.claude/settings.json" ;;
      codex) config="${CODEX_HOME:-$HOME/.codex}/config.toml" ;;
      opencode) config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" ;;
    esac
  else
    case "$agent" in
      claude) config="$PWD/.mcp.json" ;;
      codex) config="$PWD/.codex/config.toml" ;;
      opencode) config="$PWD/opencode.json" ;;
    esac
  fi
  if [[ "$agent" == "opencode" && -f "${config}c" ]]; then config="${config}c"; fi
  printf '%s' "$config"
}

# ---------------------------------------------------------------------------
# List (plaintext)
# ---------------------------------------------------------------------------

cmd_list() {
  printf "${CYAN}lidaning-skills${NC} ${DIM}[$AGENT, $SCOPE]${NC}\n\n"
  while IFS= read -r name; do
    local dir scope desc marker
    dir=$(skill_dir "$name")
    scope="$SCOPE"
    desc=$(skill_desc "$dir")
    if is_installed "$name"; then
      marker="${GREEN}[installed]${NC}"
    else
      marker="${DIM}[not installed]${NC}"
    fi
    printf "  %-22s %-8s %b  %b\n" "$name" "[$scope]" "$marker" "$desc"
  done < <(skill_names)
  echo ""
}

# ---------------------------------------------------------------------------
# MCP inject: write skill mcp.json configs into the selected scope
# ---------------------------------------------------------------------------

# Returns a space-separated list of "name:mcp_json_path" for skills that ship mcp.json
skills_with_mcp() {
  while IFS= read -r name; do
    local dir mcp
    dir=$(skill_dir "$name")
    mcp="$dir/mcp.json"
    [[ -f "$mcp" ]] && printf '%s\n' "$name"
  done < <(skill_names)
}

cmd_mcp_inject() {
  local names=()
  mapfile -t names < <(skills_with_mcp)
  if [[ ${#names[@]} -eq 0 ]]; then
    printf "[mcp] no skills ship mcp.json — nothing to inject.\n"
    return 0
  fi
  "$SKILLS_DIR/install.sh" "${names[@]}" "--$SCOPE" --mcp-only --agent "$AGENT"
}

# ---------------------------------------------------------------------------
# Interactive manage: unified add/remove via single checkbox UI
# ---------------------------------------------------------------------------

cmd_manage() {
  if ! command -v gum &>/dev/null; then
    printf "${YELLOW}gum not found — falling back to plain list.${NC}\n"
    printf "Install gum: https://github.com/charmbracelet/gum\n\n"
    cmd_list
    exit 0
  fi

  local all_skills=()
  local was_installed=()
  local config_agent="$AGENT"
  [[ "$AGENT" == "both" || "$AGENT" == "all" ]] && config_agent="claude"
  local mcp_file
  mcp_file=$(mcp_config "$config_agent")
  local MCP_ITEM="⟶ inject MCP servers into $mcp_file"
  if [[ "$AGENT" == "both" || "$AGENT" == "all" ]]; then
    MCP_ITEM+=" + $(mcp_config codex)"
    [[ "$AGENT" == "all" ]] && MCP_ITEM+=" + $(mcp_config opencode)"
  fi

  local gum_args=(
    choose --no-limit
    --header="[$AGENT, $SCOPE] Toggle skills / MCP injection  (space=toggle  enter=confirm  q=cancel)"
    --cursor-prefix="[ ] "
    --selected-prefix="[x] "
    --unselected-prefix="[ ] "
    --cursor.foreground="#06B6D4"
    --selected.foreground="#06B6D4"
    --header.foreground="#06B6D4"
  )

  [[ -f "$mcp_file" ]] && gum_args+=(--selected="$MCP_ITEM")

  while IFS= read -r name; do
    all_skills+=("$name")
    if is_installed "$name"; then
      was_installed+=("$name")
      gum_args+=(--selected="$name")
    fi
  done < <(skill_names)

  if [[ ${#all_skills[@]} -eq 0 ]]; then
    printf "No skills found in registry.\n"
    exit 1
  fi

  local chosen
  chosen=$(printf '%s\n' "${all_skills[@]}" "$MCP_ITEM" | gum "${gum_args[@]}") || {
    printf "Cancelled.\n"
    exit 0
  }

  # Build lookup of chosen skills
  declare -A chosen_set=()
  while IFS= read -r name; do
    [[ -n "$name" ]] && chosen_set["$name"]=1
  done <<<"$chosen"

  local did_something=false

  # Install newly selected skills into the selected scope.
  for name in "${all_skills[@]}"; do
    if [[ -n "${chosen_set[$name]:-}" ]] && ! is_installed "$name"; then
      printf "${CYAN}[add]${NC} %s\n" "$name"
      "$SKILLS_DIR/install.sh" "$name" "--$SCOPE" --agent "$AGENT"
      did_something=true
    fi
  done

  # Remove newly deselected skills from the selected scope.
  for name in "${was_installed[@]}"; do
    if [[ -z "${chosen_set[$name]:-}" ]]; then
      printf "${YELLOW}[rm]${NC} %s\n" "$name"
      "$SKILLS_DIR/install.sh" --remove "$name" "--$SCOPE" --agent "$AGENT"
      did_something=true
    fi
  done

  # Inject MCP configs into the selected scope if that item was selected
  if [[ -n "${chosen_set[$MCP_ITEM]:-}" ]]; then
    cmd_mcp_inject
    did_something=true
  fi

  $did_something || printf "No changes.\n"
  echo ""
  cmd_list
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

usage() {
  printf "${CYAN}ldn${NC} — lidaning-skills manager\n\n"
  printf "  ${CYAN}ldn${NC}          Toggle skills on/off (checkbox UI)\n"
  printf "  ${CYAN}ldn list${NC}     Plain-text list with install status\n"
  printf "  ${CYAN}ldn mcp inject${NC} Write skill MCP servers into the selected scope\n\n"
  printf "  --global / -g   Manage skills for all projects (current user)\n"
  printf "  --project / -p  Manage skills in cwd (default)\n\n"
  printf "  ${CYAN}-agent <claude|codex|both|opencode|all>${NC}  Agent to manage skills for (default: claude)\n"
  printf "      claude    .claude/skills/, .mcp.json\n"
  printf "      codex     .agents/skills/, .codex/config.toml\n"
  printf "      both      Claude Code + Codex; all also includes OpenCode\n"
  printf "      opencode  .opencode/skills/, opencode.json\n"
  printf "  e.g. ${CYAN}ldn -agent opencode${NC}, ${CYAN}ldn --global --agent codex${NC}\n"
}

# Agent and scope options may appear anywhere; everything else is the command.
AGENT="claude"
SCOPE="project"
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --global | -g) SCOPE="global"; shift ;;
  --project | -p) SCOPE="project"; shift ;;
  -agent | --agent | -a)
    [[ $# -ge 2 ]] || { printf "ldn: %s needs claude, codex, both, opencode or all\n" "$1" >&2; exit 1; }
    AGENT="$2"; shift 2 ;;
  -agent=* | --agent=*) AGENT="${1#*=}"; shift ;;
  *) ARGS+=("$1"); shift ;;
  esac
done
case "$AGENT" in
claude | codex | both | opencode | all) ;;
*) printf "ldn: unknown agent '%s' (expected claude, codex, both, opencode or all)\n" "$AGENT" >&2; exit 1 ;;
esac
# install.sh reads the agent from LDN_AGENT
export LDN_AGENT="$AGENT"
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-}" in
list | ls) cmd_list ;;
mcp)
  case "${2:-}" in
  inject) cmd_mcp_inject ;;
  *) printf "Usage: ldn mcp inject\n" ;;
  esac
  ;;
-h | --help) usage ;;
"") cmd_manage ;;
*) usage ;;
esac
